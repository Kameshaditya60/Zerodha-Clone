# Copy this file to .env and fill in real values.
#
# Create React App only injects env vars that start with REACT_APP_.
# Vars without that prefix are silently ignored and the code falls back
# to the hardcoded localhost defaults.

# Backend API root (Express server)
REACT_APP_BACKEND_URL=http://localhost:5000

# Dashboard app root (the post-login SPA on port 3001)
# After a successful login/signup the landing page redirects here.
REACT_APP_DASHBOARD_URL=http://localhost:3001
