# Copy this file to .env and fill in real values.
#
# Create React App only injects env vars that start with REACT_APP_.
# Vars without that prefix are silently ignored and the code falls back
# to the hardcoded localhost defaults.

# Landing app root (login/signup lives there).
# AuthCheck bounces unauthenticated users to {LANDING_URL}/login.
REACT_APP_LANDING_URL=http://localhost:3000

# Backend API root (Express server).
# Currently read in StockService.js / UserService.js / Holdings.js /
# Positions.js -- those still reference unprefixed BACKEND_URL and will
# be migrated in a follow-up PR. Document the prefixed name now so the
# .env is ready for that change.
REACT_APP_BACKEND_URL=http://localhost:5000
